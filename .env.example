# HTTPS profile only: DNS name, without protocol or path.
SITE_DOMAIN=invest.example.com
# Optional local host port (the application inside Docker always uses 8501).
INVEST_HOST_PORT=8501

# Optional AI interpretation; leave the key empty for analysis without AI.
# Put actual credentials only in an untracked .env file or a secret manager.
INVEST_AI_API_KEY=
INVEST_AI_BASE_URL=https://api.openai.com/v1
INVEST_AI_MODEL=gpt-4.1-mini
# For Alibaba Cloud DashScope, use the matching key with:
# INVEST_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# INVEST_AI_MODEL=qwen-plus
